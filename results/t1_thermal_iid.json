      "src2_y": -0.5557558953762054,
      "src2_i": -0.6890826225280762
    }
  },
  "verdict": "MARGINAL",
  "verdict_detail": "signal present (best min 0.343) but the reflex bar (all params >= 0.9 at >= 2 resolutions) not met",

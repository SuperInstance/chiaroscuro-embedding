{
  "experiment": "c2-vlm-ground-truth",
  "repo": "chiaroscuro-embedding",
  "question": "which chiaroscuro render settings leave a real vision model's (CLIP zero-shot) interpretation of video readable from the rendered TEXT alone?",
  "loop": "ffmpeg lavfi feed -> CLIP zero-shot argmax caption per frame (the discriminator's ground truth) -> chiaroscuro glyph render of the SAME frames -> text-only reader predicts the caption index (the generator sweeps)",
  "feed": {
    "sources": [
      "testsrc2",
      "smptebars",
      "mandelbrot",
      "life",
      "gradients"
    ],
    "n_raw_frames": 500,
    "fps": 10,
    "resolution": "320x240",
    "note": "10 s per source; smptebars is static by design (easy class)"
  },
  "ground_truth": {
    "model": "openai/clip-vit-base-patch32 (cached, zero-shot, fp16 GPU)",
    "captions": [
      "a video test pattern with moving bars and grids",
      "a television color calibration test pattern with solid colored bars",
      "a colorful fractal zooming in",
      "a black and white cellular automaton simulation of cells evolving",
      "a smooth colorful gradient slowly shifting and blending",
      "a person walking down a city street",
      "a cat sitting on a couch",
      "a night sky full of stars",
      "a blank white screen",
      "a page of text on a computer screen",
      "a busy highway with cars",
      "a crowd of people at a concert"
    ],
    "captions_n": 6,
    "rule": "argmax caption per frame over softmax(cos*100); label = CLIP's interpretation, distractor-caption frames kept as-is",
    "margin_distribution": {
      "percentiles": {
        "0": 0.008679479360580444,
        "5": 0.3617781400680542,
        "25": 0.7749289870262146,
        "50": 0.8584940433502197,
        "75": 0.9743479490280151,
        "95": 0.9826251864433289,
        "100": 0.9905357956886292
      },
      "mean": 0.8160640597343445
    },
    "argmax_caption_counts": {
      "a video test pattern with moving bars and grids": 4,
      "a television color calibration test pattern with solid colored bars": 196,
      "a colorful fractal zooming in": 100,
      "a black and white cellular automaton simulation of cells evolving": 97,
      "a smooth colorful gradient slowly shifting and blending": 100,
      "a night sky full of stars": 3
    },
    "per_source_agreement_with_intended": {
      "testsrc2": 0.04,
      "smptebars": 1.0,
      "mandelbrot": 1.0,
      "life": 0.97,
      "gradients": 1.0
    },
    "interpretation_note": "CLIP (single-frame) cannot separate testsrc2 from smptebars \u2014 both read as the calibration-bars caption; 3 life frames read as 'night sky full of stars'. The label is the discriminator's interpretation, not the generator's intent. Effective classes ~4 + tiny off-label groups.",
    "margin_filter": {
      "threshold": 0.1,
      "dropped": 4,
      "kept": 496
    }
  },
  "splits": {
    "scheme": "temporal 70/15/15 per source (feed order, after margin filter) \u2014 no random shuffle: adjacent frames are near-duplicates",
    "sizes": [
      347,
      74,
      75
    ],
    "kept_per_source": {
      "testsrc2": 96,
      "smptebars": 100,
      "mandelbrot": 100,
      "life": 100,
      "gradients": 100
    },
    "label_counts_all": {
      "0": 3,
      "1": 193,
      "2": 100,
      "3": 97,
      "4": 100,
      "7": 3
    }
  },
  "readers": {
    "ridge": "least-squares classification: dual ridge on native text features vs one-hot, alpha in [10,100,1000] picked on val accuracy, argmax",
    "mlp": "PCA-100 -> StandardScaler -> MLPClassifier(64)",
    "pixels_control": "SAME ridge-onehot reader on L2-normalized CLIP image embeddings (raw-pixels probe)",
    "text_features": "per cell: tone index / edge level / edge dir x/y (lossless read of the glyph grid)"
  },
  "scoring": {
    "prior": "test majority-class frequency = 0.4000",
    "gate": "KEEP iff some setting beats prior by >= 15 acc pts AND reaches >= 60% of pixels control; KILL iff nothing beats prior by 15 pts; else INCONCLUSIVE"
  },
  "pixels_control_acc": 1.0,
  "verdict": "KEEP",
  "verdict_detail": "best margin over prior = +60.0 pts, best ratio of pixels control = 1.000, settings beating prior by >= 15: 34/34",
  "n_settings": 34,

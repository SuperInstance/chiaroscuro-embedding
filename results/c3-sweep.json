{
  "experiment": "c3-framerate-vs-pixels",
  "repo": "chiaroscuro-embedding",
  "question": "at a fixed character budget (chars/sec), is information better carried by MORE frames at LOWER glyph resolution, or FEWER frames at HIGHER glyph resolution? (SEED: 'chiaroscuro can crank framerate to make up for pixel loss')",
  "feed": {
    "sources": [
      "testsrc2",
      "smptebars",
      "mandelbrot",
      "life",
      "gradients"
    ],
    "master_fps": 20,
    "seconds_per_source": 10,
    "n_master_frames": 1000,
    "resolution": "320x240",
    "cell_strides": {
      "2.5": 8,
      "5.0": 4,
      "10.0": 2,
      "20.0": 1
    }
  },
  "ground_truth": {
    "model": "openai/clip-vit-base-patch32",
    "rule": "CLIP zero-shot argmax caption per MASTER frame (20 fps); every cell samples labels from this one labeling",
    "captions_n": 12,
    "margin": {
      "percentiles": {
        "0": 0.0011120438575744629,
        "5": 0.38541460037231445,
        "25": 0.7201725244522095,
        "50": 0.9492081999778748,
        "75": 0.9743479490280151,
        "95": 0.9840531349182129,
        "100": 0.9909555912017822
      },
      "mean": 0.8268369436264038
    },
    "argmax_caption_counts": {
      "a video test pattern with moving bars and grids": 4,
      "a television color calibration test pattern with solid colored bars": 396,
      "a colorful fractal zooming in": 200,
      "a black and white cellular automaton simulation of cells evolving": 199,
      "a smooth colorful gradient slowly shifting and blending": 200,
      "a night sky full of stars": 1
    },
    "per_source_agreement_with_intended": {
      "testsrc2": 0.02,
      "smptebars": 1.0,
      "mandelbrot": 1.0,
      "life": 0.995,
      "gradients": 1.0
    },
    "margin_filter": "NONE (pre-registered): label noise identical across cells; comparison is paired"
  },
  "protocol": {
    "render_dials": {
      "ramp": "classic",
      "tone_amt": 100,
      "edge_amt": 60,
      "edge_thresh": 4,
      "edge_gain": 10,
      "relief": 70,
      "contrast": 25,
      "gamma": 100
    },
    "text_features": "8x6 block-pooled histograms over glyph vocabulary (V=23); dim = 1104 for EVERY cell (reader capacity constant)",
    "variants": {
      "single": "current frame's text only",
      "stacked": "last k=4 frames' text concatenated (low-fps cells get a longer temporal reach per stack; budget = 4x single)"
    },
    "readers": "c2's exact readers, reused by import: dual ridge one-hot (alpha in {10,100,1000} on val) + PCA->MLP(64)",
    "cv": "blocked 5-fold: contiguous temporal blocks per source; every sampled frame is a test target exactly once; val = last 15% of train per source",
    "budget_rule": "chars/sec = fps * cols * rows (fixed-width text frame, blanks count)"
  },
  "gates": {
    "rule": "FRAMERATE-WINS iff >= 2/4 matched pairs have acc(high-fps) - acc(low-fps) >= +5 pts and more pairs favor high-fps; RESOLUTION-WINS the reverse; else TIE. Headline = stacked variant.",
